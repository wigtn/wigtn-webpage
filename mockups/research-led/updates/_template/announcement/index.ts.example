/**
 * Update: <package or model> - announcement.
 *
 * Copy this file to `updates/<slug>/index.ts` and drop the images in beside it.
 *
 * Every path below is written from the *destination*, so the whole block stays
 * true once copied, which is the only place it lives permanently:
 *   - register the export in `../../data.ts`;
 *   - the outline for this kind of post is `../_template/announcement/STRUCTURE.md`;
 *   - the rules every template shares are in `../_template/README.md`.
 *
 * Two things therefore look wrong while the file still sits in `_template/`:
 * those doc paths, and the data import, which reads `../../../data` here and
 * becomes `../../data` one level shallower in a real post folder. Fix the
 * import when you copy. Kept as `.example` rather than `.ts` so the template
 * does not fail the typecheck on its placeholder imports.
 */

import type { Article, Block } from "../../../data";
import cover from "./cover.png";

const p = (text: string): Block => ({ t: "p", text });

/* Export a `*_COVER` constant ONLY if something outside this post reuses the
 * image, a MILESTONES entry on the homepage rail, a card. Otherwise delete
 * this line and keep `cover` module-local. See ../README.md. */
export const MY_NEW_POST_COVER = cover.src;

export const myNewPost: Article = {
  slug: "my-new-post", // must match the folder name
  kind: "report",
  channel: "newsroom",
  newsTopic: "release",
  tag: "RELEASE",
  title: "", // what shipped, at which version, doing what
  summary: "", // one or two sentences; used on cards
  date: "2026.01.01",
  author: "WIGTN",
  readTime: "2 min",
  image: cover.src,
  /* The deep write-up lives on the report blog; the note links it, never
   * duplicates it. */
  externalUrl: "",
  /* One placeholder on purpose. `ArticleDetail` keys these by `href`, so two
   * entries left empty are two identical React keys, and an empty `href` with
   * target="_blank" renders a live button that reopens the current page. Fill
   * this one, then add the others. Tech-report links go through
   * `techReportHref` from "../../links", never a value import from data. */
  links: [{ label: "npm", href: "" }],
  body: [
    p("Lede: what is public now, where it lives, what it does, and when."),

    { t: "h", text: "Get it" },
    p("The install line or model id, verbatim, in the first screen of the post."),
    /* A single command goes in a `quote`. A sequence goes in a `list`: a quote
     * renders as one paragraph and the browser collapses any padding used to
     * fake a line break. */
    { t: "quote", text: "npm install <package>" },
    /* No image block. An announcement carries one image and it is already the
     * cover, one screen up. The same frame twice in one scroll reads as a
     * mistake, which is why STRUCTURE.md says not to. */

    { t: "h", text: "What shipped" },
    {
      t: "list",
      items: [
        "The artifacts, named exactly: weights or an adapter, data, eval code, licence.",
        "The version and its date.",
        "What is deliberately not included.",
      ],
    },

    { t: "h", text: "Read the report" },
    p(
      "One or two lines, then the link. The method, the numbers and the limits " +
        "live on the tech-report site, not here.",
    ),
  ],
};
